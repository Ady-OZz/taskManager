# ===========================
# BACKEND ENVIRONMENT VARIABLES
# ===========================

# Server port (default: 5000)
PORT=5000

# ----------------------------
# MongoDB Atlas Connection
# ----------------------------
# Where to get: https://cloud.mongodb.com → Cluster → Connect → Drivers → Node.js
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Replace <username>, <password> with your database user credentials
# Replace <cluster> with your cluster address (e.g., cluster0.abc123)
# Replace <dbname> with your database name (e.g., taskboard)
MONGODB_URI=

# ----------------------------
# Firebase Admin SDK (Service Account)
# ----------------------------
# Where to get: Firebase Console → Project Settings (⚙️) → Service Accounts tab → Generate New Private Key
# This downloads a JSON file containing all three values below.

# Found in the JSON key: "project_id"
FIREBASE_PROJECT_ID=

# Found in the JSON key: "client_email"
# Format: firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_EMAIL=

# Found in the JSON key: "private_key"
# IMPORTANT: Wrap the entire value in double quotes, including the BEGIN/END markers
# The \n characters inside the key are literal escape sequences — keep them as-is
# Example: "-----BEGIN PRIVATE KEY-----\nMIIEv...long string...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
