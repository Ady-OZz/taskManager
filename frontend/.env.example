# ===========================
# FRONTEND ENVIRONMENT VARIABLES
# ===========================
# All frontend env vars MUST start with VITE_ to be accessible in the app.

# ----------------------------
# Backend API URL
# ----------------------------
# Local development: http://localhost:5000/api
# Production: Your deployed backend URL + /api (e.g., https://taskboard-api.onrender.com/api)
VITE_API_BASE_URL=http://localhost:5000/api

# ----------------------------
# Firebase Web SDK Config
# ----------------------------
# Where to get: Firebase Console → Project Settings (⚙️) → General tab → Your Apps → Web app (</>)
# If no web app exists, click "Add app" → Web → Register app → copy the config object

# Found in firebaseConfig.apiKey
# Format: AIzaSy... (39 characters)
VITE_FIREBASE_API_KEY=

# Found in firebaseConfig.authDomain
# Format: your-project-id.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=

# Found in firebaseConfig.projectId
# Format: your-project-id (same as Firebase project ID)
VITE_FIREBASE_PROJECT_ID=

# Found in firebaseConfig.appId
# Format: 1:123456789:web:abcdef123456
VITE_FIREBASE_APP_ID=
